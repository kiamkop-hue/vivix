                                  type: string
                                  description: Caller-defined audio asset id.
                                url:
                                  type: string
                                  description: >-
                                    HTTPS URL for the audio file. The URL must
                                    be directly fetchable by Vivix without
                                    custom request headers.
                                mime_type:
                                  type: string
                                  description: >-
