                      properties:
                        enable_a2a:
                          type: boolean
                          default: false
                          description: >-
                            Set `true` to drive the avatar with your
                            application’s live audio.
                        provider:
                          type: string
                          description: >-
                            Use `passthrough` to render the audio you publish to
                            the RTC room.
                          enum:
                            - passthrough
